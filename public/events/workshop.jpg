<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 360" width="100%" height="100%">
  <defs>
    <linearGradient id="workshop-bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#451a03"/>
      <stop offset="55%" stop-color="#78350f"/>
      <stop offset="100%" stop-color="#b45309"/>
    </linearGradient>
    <radialGradient id="workshop-glow" cx="20%" cy="30%" r="70%">
      <stop offset="0%" stop-color="#fbbf24" stop-opacity="0.3"/>
      <stop offset="100%" stop-color="#451a03" stop-opacity="0"/>
    </radialGradient>
  </defs>
  <rect width="640" height="360" fill="url(#workshop-bg)"/>
  <rect width="640" height="360" fill="url(#workshop-glow)"/>
  <!-- Subtle architectural isometric lines -->
  <g stroke="#fde68a" stroke-opacity="0.1" stroke-width="1.2">
    <line x1="0" y1="0" x2="640" y2="360"/>
    <line x1="160" y1="0" x2="640" y2="270"/>
    <line x1="0" y1="90" x2="480" y2="360"/>
    <line x1="0" y1="360" x2="640" y2="0"/>
    <line x1="0" y1="270" x2="480" y2="0"/>
    <line x1="160" y1="360" x2="640" y2="90"/>
  </g>
</svg>
