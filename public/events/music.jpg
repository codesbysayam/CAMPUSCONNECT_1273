<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 360" width="100%" height="100%">
  <defs>
    <linearGradient id="music-bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#270a03"/>
      <stop offset="50%" stop-color="#431407"/>
      <stop offset="100%" stop-color="#9a3412"/>
    </linearGradient>
    <radialGradient id="music-glow" cx="40%" cy="40%" r="65%">
      <stop offset="0%" stop-color="#fb923c" stop-opacity="0.35"/>
      <stop offset="100%" stop-color="#270a03" stop-opacity="0"/>
    </radialGradient>
  </defs>
  <rect width="640" height="360" fill="url(#music-bg)"/>
  <rect width="640" height="360" fill="url(#music-glow)"/>
  <!-- Smooth harmonic sound wave ripples -->
  <g fill="none" stroke="#fed7aa" stroke-opacity="0.12" stroke-width="2">
    <path d="M-40,180 Q120,60 280,180 T600,180 T920,180"/>
    <path d="M-40,210 Q140,110 320,210 T680,210"/>
    <path d="M-40,150 Q100,10 240,150 T520,150"/>
  </g>
</svg>
