<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 360" width="100%" height="100%">
  <defs>
    <linearGradient id="default-bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#111827"/>
      <stop offset="50%" stop-color="#1f2937"/>
      <stop offset="100%" stop-color="#374151"/>
    </linearGradient>
    <radialGradient id="default-glow" cx="60%" cy="30%" r="65%">
      <stop offset="0%" stop-color="#d1d5db" stop-opacity="0.25"/>
      <stop offset="100%" stop-color="#111827" stop-opacity="0"/>
    </radialGradient>
  </defs>
  <rect width="640" height="360" fill="url(#default-bg)"/>
  <rect width="640" height="360" fill="url(#default-glow)"/>
  <g fill="none" stroke="#e5e7eb" stroke-opacity="0.1" stroke-width="1.8">
    <circle cx="320" cy="180" r="140"/>
    <circle cx="320" cy="180" r="220"/>
  </g>
</svg>
