<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 640 360" width="100%" height="100%">
  <defs>
    <linearGradient id="tech-bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0f172a"/>
      <stop offset="50%" stop-color="#1e293b"/>
      <stop offset="100%" stop-color="#0284c7"/>
    </linearGradient>
    <linearGradient id="tech-glow" x1="0%" y1="100%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#38bdf8" stop-opacity="0.2"/>
      <stop offset="100%" stop-color="#818cf8" stop-opacity="0"/>
    </linearGradient>
    <radialGradient id="tech-light" cx="80%" cy="20%" r="60%">
      <stop offset="0%" stop-color="#38bdf8" stop-opacity="0.35"/>
      <stop offset="100%" stop-color="#0f172a" stop-opacity="0"/>
    </radialGradient>
  </defs>
  <rect width="640" height="360" fill="url(#tech-bg)"/>
  <rect width="640" height="360" fill="url(#tech-light)"/>
  <!-- Elegant subtle perspective grid -->
  <g stroke="#38bdf8" stroke-opacity="0.12" stroke-width="1.2">
    <line x1="0" y1="90" x2="640" y2="90"/>
    <line x1="0" y1="180" x2="640" y2="180"/>
    <line x1="0" y1="270" x2="640" y2="270"/>
    <line x1="160" y1="0" x2="160" y2="360"/>
    <line x1="320" y1="0" x2="320" y2="360"/>
    <line x1="480" y1="0" x2="480" y2="360"/>
    <path d="M0,360 L240,180 L640,180" fill="none"/>
    <path d="M120,0 L320,180 L520,360" fill="none"/>
  </g>
  <!-- Subtle ambient glow lines -->
  <path d="M-50,300 Q200,120 690,160" fill="none" stroke="url(#tech-glow)" stroke-width="80"/>
  <circle cx="512" cy="110" r="3" fill="#7dd3fc" opacity="0.6"/>
  <circle cx="320" cy="180" r="4" fill="#38bdf8" opacity="0.5"/>
  <circle cx="160" cy="270" r="3" fill="#0284c7" opacity="0.6"/>
</svg>
